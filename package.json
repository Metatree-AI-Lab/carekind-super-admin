{
	"name": "carekind-super-admin",
	"version": "0.1.0",
	"private": true,
	"description": "careKind Super Admin — internal cross-tenant console (phase 1).",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit -p tsconfig.json && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "eslint src",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@carekind/shared": "file:../shared",
		"@tanstack/react-query": "^5.104.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^7.18.4"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"eslint": "^10.13.0",
		"jsdom": "^27.4.0",
		"prettier": "^3.9.10",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^7.3.7",
		"vitest": "^4.1.12"
	}
}
